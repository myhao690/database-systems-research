diff --git a/test/sql/optimizer/arg_max_struct_payload_pruning.test b/test/sql/optimizer/arg_max_struct_payload_pruning.test
new file mode 100644
index 00000000..f85ea20a
--- /dev/null
+++ b/test/sql/optimizer/arg_max_struct_payload_pruning.test
@@ -0,0 +1,174 @@
+# name: test/sql/optimizer/arg_max_struct_payload_pruning.test
+# description: Experimental arg_max STRUCT payload pruning (run with DUCKDB_TOPK_PAYLOAD_PRUNING=1)
+# group: [optimizer]
+
+statement ok
+CREATE TABLE topk_prune(q INTEGER, extra VARCHAR, score BIGINT, grp INTEGER);
+
+statement ok
+INSERT INTO topk_prune VALUES (NULL, 'a', 20, 1), (7, 'b', 10, 1), (4, 'c', 9, 2), (5, 'd', NULL, 2);
+
+# A non-null STRUCT with a NULL field must remain an eligible payload.
+query I
+SELECT (arg_max(struct_pack(q := q, extra := extra), score)).q FROM topk_prune WHERE grp = 1;
+----
+NULL
+
+# The selected field moves from index 1 to index 0, without becoming scalar.
+query I
+SELECT (arg_max(struct_pack(extra := extra, q := q), score)).q FROM topk_prune WHERE grp = 2;
+----
+4
+
+# Two distinct fields of one aggregate result require the whole payload: fallback.
+query II
+SELECT top.q, top.extra FROM (SELECT arg_max(struct_pack(q := q, extra := extra), score) AS top FROM topk_prune WHERE grp = 2);
+----
+4	c
+
+# DISTINCT changes payload equivalence; the optimizer must not prune it.
+query I
+SELECT (arg_max(DISTINCT struct_pack(q := q, extra := extra), score)).q FROM topk_prune WHERE grp = 2;
+----
+4
+
+# A stored nullable STRUCT must not be repacked, or NULL eligibility changes.
+query I
+WITH t(s, score) AS (
+  VALUES (NULL::STRUCT(q INTEGER, extra VARCHAR), 20::BIGINT), (struct_pack(q := 7, extra := 'b'), 10::BIGINT)
+)
+SELECT (arg_max(s, score)).q FROM t;
+----
+7
+
+# Top-K: the retained INTEGER field moves past a discarded VARCHAR field.
+# The NULL child remains a valid STRUCT payload and occupies one of the two slots.
+query II
+SELECT length(top), list_sum(list_transform(top, lambda x: x.q))
+FROM (SELECT arg_max(struct_pack(extra := extra, q := q), score, 2) AS top
+      FROM topk_prune WHERE grp = 1);
+----
+2	7
+
+# A row with NULL score is not a candidate, even for Top-K.
+query I
+SELECT list_sum(list_transform(top, lambda x: x.q))
+FROM (SELECT arg_max(struct_pack(extra := extra, q := q), score, 2) AS top
+      FROM topk_prune WHERE grp = 2);
+----
+4
+
+# Two list_transform consumers need different fields: conservative fallback.
+query II
+SELECT list_sum(list_transform(top, lambda x: x.q)),
+       list_sum(list_transform(top, lambda x: length(x.extra)))
+FROM (SELECT arg_max(struct_pack(extra := extra, q := q), score, 2) AS top
+      FROM topk_prune WHERE grp = 1);
+----
+7	2
+
+# A whole-LIST consumer defeats the narrower field demand.
+query II
+SELECT list_sum(list_transform(top, lambda x: x.q)), length(top)
+FROM (SELECT arg_max(struct_pack(extra := extra, q := q), score, 2) AS top
+      FROM topk_prune WHERE grp = 1);
+----
+7	2
+
+# DISTINCT payloads may be unequal only in a discarded field. Do not rewrite.
+query I
+WITH t(q, extra, score) AS (VALUES (1, 'a', 10::BIGINT), (1, 'b', 10::BIGINT), (2, 'c', 9::BIGINT))
+SELECT list_sort(list_transform(top, lambda x: x.q))
+FROM (SELECT arg_max(DISTINCT struct_pack(q := q, extra := extra), score, 3) AS top FROM t);
+----
+[1, 1, 2]
+
+# Equal scores retain both payloads; order is normalized because SQL does not promise tie order.
+query I
+WITH t(q, extra, score) AS (VALUES (1, 'a', 10::BIGINT), (2, 'b', 10::BIGINT))
+SELECT list_sort(list_transform(top, lambda x: x.q))
+FROM (SELECT arg_max(struct_pack(extra := extra, q := q), score, 2) AS top FROM t);
+----
+[1, 2]
+
+# A static extraction from an ordinary LIST column is not an arg_max rewrite.
+query I
+WITH t(xs) AS (VALUES ([struct_pack(q := 2, extra := 'a'), struct_pack(q := 3, extra := 'b')]))
+SELECT list_sum(list_transform(xs, lambda x: x.q)) FROM t;
+----
+5
+
+statement ok
+CREATE TABLE topk_list_source AS SELECT [struct_pack(extra := 'a', q := 2), struct_pack(extra := 'b', q := 3)] AS xs;
+
+statement ok
+EXPLAIN SELECT list_sum(list_transform(xs, lambda x: x.q)) FROM topk_list_source;
+
+statement ok
+EXPLAIN ANALYZE SELECT list_sum(list_transform(xs, lambda x: x.q)) FROM topk_list_source;
+
+query I
+SELECT list_sum(list_transform(xs, lambda x: x.q)) FROM topk_list_source;
+----
+5
+
+# FILTER must remain on the original aggregate binding.
+query I
+SELECT list_sum(list_transform(top, lambda x: x.q))
+FROM (SELECT arg_max(struct_pack(extra := extra, q := q), score, 2) FILTER (WHERE q IS NOT NULL) AS top
+      FROM topk_prune WHERE grp = 1);
+----
+7
+
+# A complex removed expression may throw. The rewrite must not suppress it.
+statement error
+SELECT list_sum(list_transform(top, lambda x: x.q))
+FROM (SELECT arg_max(struct_pack(q := q, extra := CAST(extra AS INTEGER)), score, 2) AS top
+      FROM topk_prune WHERE grp = 1);
+----
+Could not convert string 'a' to INT32
+
+# VARCHAR selection changes the Lambda result type, not the LIST cardinality.
+query T
+SELECT list_extract(list_transform(top, lambda x: x.extra), 1)
+FROM (SELECT arg_max(struct_pack(q := q, extra := extra), score, 2) AS top
+      FROM topk_prune WHERE grp = 1);
+----
+a
+
+# A DECIMAL field remains DECIMAL after field-index remapping.
+query T
+WITH t(q, extra, score) AS (VALUES (12.34::DECIMAL(12,2), 'a', 10::BIGINT),
+                                 (4.56::DECIMAL(12,2), 'b', 9::BIGINT))
+SELECT typeof(list_extract(list_transform(top, lambda x: x.q), 1))
+FROM (SELECT arg_max(struct_pack(extra := extra, q := q), score, 2) AS top FROM t);
+----
+DECIMAL(12,2)
+
+# Nested x.nested.q is outside the direct-field rule and must stay valid.
+query I
+SELECT list_sum(list_transform(top, lambda x: x.nested.q))
+FROM (SELECT arg_max(struct_pack(extra := extra, nested := struct_pack(q := q)), score, 2) AS top
+      FROM topk_prune WHERE grp = 1);
+----
+7
+
+# Parallel aggregate/scan with unique score per row: no tie-order dependence.
+statement ok
+CREATE TABLE topk_parallel AS
+SELECT (i % 1000)::INTEGER AS grp, i::BIGINT AS score,
+       ('v' || i)::VARCHAR AS label, (i % 13)::INTEGER AS q
+FROM range(100000) AS t(i);
+
+statement ok
+SET threads=4;
+
+query I
+SELECT SUM(list_sum(list_transform(top, lambda x: x.q)))
+FROM (SELECT arg_max(struct_pack(label := label, q := q), score, 3) AS top
+      FROM topk_parallel GROUP BY grp);
+----
+18003
+
+statement ok
+SET threads=1;
diff --git a/test/sql/optimizer/arg_max_struct_payload_pruning_multifield.test b/test/sql/optimizer/arg_max_struct_payload_pruning_multifield.test
new file mode 100644
index 00000000..9ecc93ac
--- /dev/null
+++ b/test/sql/optimizer/arg_max_struct_payload_pruning_multifield.test
@@ -0,0 +1,177 @@
+# name: test/sql/optimizer/arg_max_struct_payload_pruning_multifield.test
+# description: Top-K static multi-consumer field union, with OFF/ON correctness
+# group: [optimizer]
+
+statement ok
+CREATE TABLE topk_multifield(q INTEGER, extra VARCHAR, pad BIGINT, score BIGINT, grp INTEGER);
+
+statement ok
+INSERT INTO topk_multifield VALUES
+  (NULL, 'a', 101, 20, 1), (7, 'bb', 102, 10, 1), (4, 'ccc', 103, 9, 1),
+  (5, 'dddd', 104, NULL, 1), (2, NULL, 105, 10, 2), (3, 'z', 106, 9, 2);
+
+# The two direct consumers need different fields; pad is unnecessary.
+query IT
+SELECT list_sum(list_transform(top, lambda x: x.q)),
+       array_to_string(list_transform(top, lambda x: x.extra), ',')
+FROM (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+      FROM topk_multifield WHERE grp = 1);
+----
+11	a,bb,ccc
+
+# Repeated demand is de-duplicated; only q and score are needed.
+query II
+SELECT list_sum(list_transform(top, lambda x: x.q)),
+       list_sum(list_transform(top, lambda x: x.q))
+FROM (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+      FROM topk_multifield WHERE grp = 1);
+----
+11	11
+
+# Reverse consumer order must produce the same union and field remapping.
+query TI
+SELECT array_to_string(list_transform(top, lambda x: x.extra), ','),
+       list_sum(list_transform(top, lambda x: x.q))
+FROM (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+      FROM topk_multifield WHERE grp = 1);
+----
+a,bb,ccc	11
+
+# Both consumers of the same Top-K output survive grouping into multiple rows.
+# One group has a NULL selected field; payload remains STRUCT, not a scalar.
+query IIT
+SELECT grp, list_sum(list_transform(top, lambda x: x.q)),
+       array_to_string(list_transform(top, lambda x: x.extra), ',')
+FROM (SELECT grp, arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+      FROM topk_multifield GROUP BY grp) ORDER BY grp;
+----
+1	11	a,bb,ccc
+2	5	z
+
+# A whole-LIST consumer keeps all fields, irrespective of visit order.
+query II
+SELECT list_sum(list_transform(top, lambda x: x.q)), length(top)
+FROM (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+      FROM topk_multifield WHERE grp = 1);
+----
+11	3
+
+query II
+SELECT length(top), list_sum(list_transform(top, lambda x: x.q))
+FROM (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+      FROM topk_multifield WHERE grp = 1);
+----
+3	11
+
+# A separate demand for a field outside the two Lambdas must not be dropped.
+query II
+SELECT list_sum(list_transform(top, lambda x: x.q)), top[1].pad
+FROM (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+      FROM topk_multifield WHERE grp = 1);
+----
+11	101
+
+# One-column projection aliases may relay the field union.
+query IT
+SELECT list_sum(list_transform(top, lambda x: x.q)),
+       array_to_string(list_transform(top, lambda x: x.extra), ',')
+FROM (SELECT top FROM
+      (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+       FROM topk_multifield WHERE grp = 1));
+----
+11	a,bb,ccc
+
+# Two successive single-column aliases must preserve both field demands.
+query IT
+SELECT list_sum(list_transform(z, lambda x: x.q)),
+       array_to_string(list_transform(z, lambda x: x.extra), ',')
+FROM (SELECT y AS z FROM (SELECT top AS y FROM
+      (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+       FROM topk_multifield WHERE grp = 1)));
+----
+11	a,bb,ccc
+
+# The same aggregate flows through two distinct projection aliases.
+query IT
+SELECT list_sum(list_transform(a, lambda x: x.q)),
+       array_to_string(list_transform(b, lambda x: x.extra), ',')
+FROM (SELECT top AS a, top AS b FROM
+      (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+       FROM topk_multifield WHERE grp = 1));
+----
+11	a,bb,ccc
+
+# Branches may each pass through another simple alias layer.
+query IT
+SELECT list_sum(list_transform(a, lambda x: x.q)),
+       array_to_string(list_transform(b, lambda x: x.extra), ',')
+FROM (SELECT aa AS a, bb AS b FROM
+      (SELECT top AS aa, top AS bb FROM
+       (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+        FROM topk_multifield WHERE grp = 1)));
+----
+11	a,bb,ccc
+
+# An earlier unused output may be removed; the two surviving aliases must
+# still relay their own demands after their output bindings shift.
+query IT
+SELECT list_sum(list_transform(a, lambda x: x.q)),
+       array_to_string(list_transform(b, lambda x: x.extra), ',')
+FROM (SELECT 42 AS unused, top AS a, top AS b FROM
+      (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+       FROM topk_multifield WHERE grp = 1));
+----
+11	a,bb,ccc
+
+# A whole-payload use on one branch forbids pruning through the other branch.
+query II
+SELECT list_sum(list_transform(a, lambda x: x.q)), b[1].pad
+FROM (SELECT top AS a, top AS b FROM
+      (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+       FROM topk_multifield WHERE grp = 1));
+----
+11	101
+
+# A nonmaterialized CTE is eligible only if the planner inlines it safely.
+query IT
+WITH topk AS NOT MATERIALIZED
+  (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+   FROM topk_multifield WHERE grp = 1)
+SELECT list_sum(list_transform(top, lambda x: x.q)),
+       array_to_string(list_transform(top, lambda x: x.extra), ',') FROM topk;
+----
+11	a,bb,ccc
+
+# Materialization and a computed lambda are correctness-only fallback checks.
+query II
+WITH topk AS MATERIALIZED
+  (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+   FROM topk_multifield WHERE grp = 1)
+SELECT list_sum(list_transform(top, lambda x: x.q)), length(top) FROM topk;
+----
+11	3
+
+query I
+SELECT list_sum(list_transform(top, lambda x: coalesce(x.q, 0) + length(x.extra)))
+FROM (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 3) AS top
+      FROM topk_multifield WHERE grp = 1);
+----
+17
+
+# NULL fields and ties must remain valid STRUCT payloads.
+query IT
+SELECT list_sum(list_transform(top, lambda x: x.q)),
+       array_to_string(list_transform(top, lambda x: x.extra), ',')
+FROM (SELECT arg_max(struct_pack(pad := pad, extra := extra, q := q), score, 2) AS top
+      FROM topk_multifield WHERE grp = 2);
+----
+5	z
+
+# A possibly throwing discarded field defeats eligibility, even with two consumers.
+statement error
+SELECT list_sum(list_transform(top, lambda x: x.q)),
+       array_to_string(list_transform(top, lambda x: x.extra), ',')
+FROM (SELECT arg_max(struct_pack(bad := CAST(extra AS INTEGER), extra := extra, q := q), score, 3) AS top
+      FROM topk_multifield WHERE grp = 1);
+----
+Could not convert string 'a' to INT32
