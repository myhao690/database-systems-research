diff --git a/test/sql/json/table/read_json_schema_buffer_release.test b/test/sql/json/table/read_json_schema_buffer_release.test
new file mode 100644
index 000000000000..af8569253005
--- /dev/null
+++ b/test/sql/json/table/read_json_schema_buffer_release.test
@@ -0,0 +1,31 @@
+# name: test/sql/json/table/read_json_schema_buffer_release.test
+# description: Schema sampling of tiny JSON files must not retain an empty maximum-sized buffer per file
+# group: [table]
+
+require json
+
+loop i 0 31
+
+statement ok
+COPY (SELECT 1 AS id) TO '{TEST_DIR}/f{i}.json' (FORMAT json);
+
+endloop
+
+statement ok
+COPY (SELECT 1 AS id, 'last' AS marker) TO '{TEST_DIR}/fzz.json' (FORMAT json);
+
+statement ok
+SET threads=1;
+
+statement ok
+SET memory_limit='500MB';
+
+query II
+SELECT count(*), count(marker) FROM read_json('{TEST_DIR}/f*.json');
+----
+32	1
+
+query II
+SELECT count(*), count(marker) FROM read_json('{TEST_DIR}/f*.json', union_by_name=true);
+----
+32	1
