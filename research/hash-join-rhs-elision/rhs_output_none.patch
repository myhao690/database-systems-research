diff --git a/test/sql/join/hash_join/hash_join_rhs_output_none.test b/test/sql/join/hash_join/hash_join_rhs_output_none.test
new file mode 100644
index 0000000000..ac841c7dc1
--- /dev/null
+++ b/test/sql/join/hash_join/hash_join_rhs_output_none.test
@@ -0,0 +1,60 @@
+# name: test/sql/join/hash_join/hash_join_rhs_output_none.test
+# description: INNER hash joins with no RHS output retain every matching row
+# group: [hash_join]
+
+statement ok
+CREATE TABLE c22_a(k INTEGER, id INTEGER)
+
+statement ok
+CREATE TABLE c22_b(k INTEGER, id INTEGER)
+
+statement ok
+INSERT INTO c22_a VALUES (1, 10), (1, 11), (2, 20), (9999999, 90), (NULL, 100)
+
+statement ok
+INSERT INTO c22_b VALUES (1, 100), (1, 101), (1, 102), (2, 200), (3, 300), (NULL, 400)
+
+# Q1: no RHS value is consumed, but duplicate multiplicity must remain.
+query I
+SELECT count(*) FROM c22_a a INNER JOIN c22_b b ON a.k = b.k
+----
+7
+
+# Probe-only detail: six copies of the two key-1 probe IDs plus one key-2 ID.
+query I
+SELECT a.id FROM c22_a a INNER JOIN c22_b b ON a.k = b.k ORDER BY a.id
+----
+10
+10
+10
+11
+11
+11
+20
+
+# Q2: build payload is required; it must keep the ordinary RHS Gather path.
+query II
+SELECT count(*), sum(b.id) FROM c22_a a INNER JOIN c22_b b ON a.k = b.k
+----
+7	806
+
+# Other join types must not use the INNER-only elision.
+query I
+SELECT count(*) FROM c22_a a LEFT JOIN c22_b b ON a.k = b.k
+----
+9
+
+statement ok
+CREATE TABLE c22_many_a AS SELECT 10000000 AS k, i AS id FROM range(3) t(i)
+
+statement ok
+CREATE TABLE c22_many_b AS SELECT 10000000 AS k, i AS id FROM range(1000) t(i)
+
+statement ok
+INSERT INTO c22_many_b VALUES (0, -1)
+
+# One input chunk must resume across multiple output chunks without losing rows.
+query II
+SELECT count(*), sum(a.id) FROM c22_many_a a INNER JOIN c22_many_b b ON a.k = b.k
+----
+3000	3000
