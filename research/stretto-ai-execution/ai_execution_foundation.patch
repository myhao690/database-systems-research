@@ -0,0 +1,256 @@
+"""Process-crash recovery and compatibility for incremental precompute state."""
+
+import json
+import os
+import stat
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+from reasondb.backends.simulate_store import SimulateStore
+from reasondb.evaluation.precompute import run_precompute
+
+
+def _record(store, question):
+    store.record_text_qa("model", question, "context", "yes", 0.0, 0.1, 0.0, 0.0, True)
+    store.mark_op_precomputed(question)
+
+
+def test_delta_round_trip_and_legacy_export(tmp_path):
+    path = tmp_path / "recording.json"
+    store = SimulateStore()
+    _record(store, "q1")
+    store.record_vision(
+        "vision", "what?", "image.png", "cat", 0.0, 0.2, 0.0, None, None, True
+    )
+    store.record_operator_config("op", {"prompt": "fixed"})
+    store.record_filter_stats("benchmark", "dev", {"matrix": [1]})
+    first = store.checkpoint_delta(path)
+    assert first.is_file()
+    assert not path.exists()
+    assert store.checkpoint_delta(path) is None
+    resumed = SimulateStore.load_incremental(path)
+    assert resumed.counts() == store.counts()
+    assert resumed.lookup_text_qa("model", "q1", "context")[0] == "yes"
+    assert resumed.lookup_vision("vision", "what?", "image.png")[0] == "cat"
+    assert resumed.get_operator_config_override("op") == {"prompt": "fixed"}
+    assert resumed.get_filter_stats("benchmark", "dev") == {"matrix": [1]}
+
+    _record(resumed, "q2")
+    resumed.checkpoint_delta(path)
+    resumed.finalize_checkpoints(path)
+    assert not SimulateStore._checkpoint_dir(path).exists()
+    assert SimulateStore.load(path)._payload() == resumed._payload()
+    assert json.loads(path.read_text())["text_qa"]
+
+
+def test_failed_delta_write_preserves_committed_state_and_can_retry(
+    tmp_path, monkeypatch
+):
+    path = tmp_path / "recording.json"
+    store = SimulateStore()
+    _record(store, "q1")
+    store.checkpoint_delta(path)
+    _record(store, "q2")
+
+    def broken_dump(_payload, stream, **_kwargs):
+        stream.write("{")
+        raise OSError("injected write failure")
+
+    with monkeypatch.context() as patch:
+        patch.setattr("reasondb.backends.simulate_store.json.dump", broken_dump)
+        with pytest.raises(OSError, match="injected write failure"):
+            store.checkpoint_delta(path)
+    assert SimulateStore.load_incremental(path).counts()["n_text_qa"] == 1
+    assert len(list(SimulateStore._checkpoint_dir(path).glob("checkpoint-*.json"))) == 1
+    store.checkpoint_delta(path)
+    assert SimulateStore.load_incremental(path).counts()["n_text_qa"] == 2
+
+
+def test_failed_final_export_keeps_prior_json_and_deltas(tmp_path, monkeypatch):
+    path = tmp_path / "recording.json"
+    store = SimulateStore()
+    _record(store, "base")
+    store.save(path)
+    _record(store, "new")
+    store.checkpoint_delta(path)
+
+    def broken_dump(_payload, stream, **_kwargs):
+        stream.write("{")
+        raise OSError("injected final export failure")
+
+    with monkeypatch.context() as patch:
+        patch.setattr("reasondb.backends.simulate_store.json.dump", broken_dump)
+        with pytest.raises(OSError, match="injected final export failure"):
+            store.finalize_checkpoints(path)
+    assert SimulateStore.load(path).counts()["n_text_qa"] == 1
+    assert SimulateStore.load_incremental(path).counts()["n_text_qa"] == 2
+
+
+def test_filter_stats_update_uses_latest_committed_delta(tmp_path):
+    path = tmp_path / "recording.json"
+    store = SimulateStore()
+    store.record_filter_stats("benchmark", "dev", {"version": 1})
+    store.save(path)
+    store.record_filter_stats("benchmark", "dev", {"version": 2})
+    store.checkpoint_delta(path)
+    assert SimulateStore.load_incremental(path).get_filter_stats(
+        "benchmark", "dev"
+    ) == {"version": 2}
+
+
+def test_final_export_committed_before_sidecar_cleanup_is_not_replayed(
+    tmp_path, monkeypatch
+):
+    path = tmp_path / "recording.json"
+    store = SimulateStore()
+    store.record_filter_stats("benchmark", "dev", {"version": 1})
+    store.checkpoint_delta(path)
+    store.record_filter_stats("benchmark", "dev", {"version": 2})
+    store.checkpoint_delta(path)
+
+    original_unlink = Path.unlink
+
+    def interrupted_cleanup(target, *args, **kwargs):
+        if target.name.startswith("checkpoint-"):
+            raise OSError("injected cleanup failure")
+        return original_unlink(target, *args, **kwargs)
+
+    with monkeypatch.context() as patch:
+        patch.setattr(Path, "unlink", interrupted_cleanup)
+        with pytest.raises(OSError, match="injected cleanup failure"):
+            store.finalize_checkpoints(path)
+
+    assert SimulateStore.load_incremental(path).get_filter_stats(
+        "benchmark", "dev"
+    ) == {"version": 2}
+    newer = SimulateStore.load(path)
+    newer.record_filter_stats("benchmark", "dev", {"version": 3})
+    newer.save(path)
+    resumed = SimulateStore.load_incremental(path)
+    assert resumed.get_filter_stats("benchmark", "dev") == {"version": 3}
+    resumed.record_filter_stats("benchmark", "dev", {"version": 4})
+    checkpoint = resumed.checkpoint_delta(path)
+    assert checkpoint.name == "checkpoint-00000003.json"
+    assert SimulateStore.load_incremental(path).get_filter_stats(
+        "benchmark", "dev"
+    ) == {"version": 4}
+
+
+def test_atomic_replacement_preserves_existing_file_permissions(tmp_path):
+    path = tmp_path / "recording.json"
+    path.write_text("{}")
+    path.chmod(0o640)
+    store = SimulateStore()
+    store.save(path)
+    assert stat.S_IMODE(path.stat().st_mode) == 0o640
+
+
+def test_delta_and_final_export_emit_telemetry(tmp_path, monkeypatch):
+    path = tmp_path / "recording.json"
+    events = []
+    monkeypatch.setattr(
+        "reasondb.backends.simulate_store._monitor.is_enabled", lambda: True
+    )
+    monkeypatch.setattr(
+        "reasondb.backends.simulate_store._monitor.record_precompute_save",
+        lambda **event: events.append(event),
+    )
+    store = SimulateStore()
+    _record(store, "q1")
+    store.checkpoint_delta(path)
+    store.finalize_checkpoints(path)
+    assert [event["kind"] for event in events] == ["delta", "full"]
+    assert all(event["size_bytes"] > 0 and event["seconds"] >= 0 for event in events)
+
+
+def test_killed_writer_before_delta_publish_keeps_previous_checkpoint(tmp_path):
+    path = tmp_path / "recording.json"
+    marker = tmp_path / "before-replace"
+    store = SimulateStore()
+    _record(store, "committed")
+    store.save(path)
+    child_code = """
+import sys, time
+from pathlib import Path
+import reasondb.backends.simulate_store as module
+path, marker = map(Path, sys.argv[1:])
+store = module.SimulateStore.load(path)
+store.record_text_qa('model', 'new', 'context', 'yes', 0.0, 0.1, 0.0, 0.0, True)
+def blocked_replace(src, dst):
+    marker.write_text('ready')
+    time.sleep(60)
+module.os.replace = blocked_replace
+store.checkpoint_delta(path)
+"""
+    environment = dict(os.environ)
+    environment["PYTHONPATH"] = str(Path(__file__).parents[1])
+    child = subprocess.Popen(
+        [sys.executable, "-c", child_code, str(path), str(marker)],
+        env=environment,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+    try:
+        deadline = time.monotonic() + 5
+        while not marker.exists() and time.monotonic() < deadline:
+            if child.poll() is not None:
+                raise AssertionError(child.communicate()[1].decode())
+            time.sleep(0.01)
+        assert marker.exists(), "writer did not reach the publication boundary"
+    finally:
+        child.kill()
+        child.communicate(timeout=5)
+    assert SimulateStore.load_incremental(path).counts()["n_text_qa"] == 1
+    recovered = SimulateStore.load_incremental(path)
+    _record(recovered, "new")
+    recovered.checkpoint_delta(path)
+    assert SimulateStore.load_incremental(path).counts()["n_text_qa"] == 2
+
+
+def test_precompute_resumes_after_failed_query_without_replaying_completed_calls(
+    tmp_path,
+):
+    class Query:
+        def __init__(self, name):
+            self.query = name
+
+    class Benchmark:
+        queries = [Query("q1"), Query("q2"), Query("q3")]
+
+    class Executor:
+        def __init__(self, fail_on=None):
+            self.fail_on = fail_on
+            self.calls = []
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *_args):
+            pass
+
+        def precompute_query(self, query, _index):
+            store = SimulateStore.get_precompute()
+            if store.is_op_precomputed(query.query):
+                return
+            if query.query == self.fail_on:
+                raise RuntimeError("injected query failure")
+            self.calls.append(query.query)
+            _record(store, query.query)
+
+    path = tmp_path / "recording.json"
+    first = Executor(fail_on="q3")
+    with pytest.raises(RuntimeError, match="injected query failure"):
+        run_precompute(Benchmark(), first, path)
+    assert first.calls == ["q1", "q2"]
+    assert not path.exists()
+    assert SimulateStore.load_incremental(path).counts()["n_text_qa"] == 2
+
+    second = Executor()
+    run_precompute(Benchmark(), second, path)
+    assert second.calls == ["q3"]
+    assert SimulateStore.load(path).counts()["n_text_qa"] == 3
+    assert not SimulateStore._checkpoint_dir(path).exists()
