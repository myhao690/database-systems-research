+"""Describe phase mix in shipped base01 CSVs without summing nested spans.
+
+These CSVs are paper artifacts. Their component times may include simulated
+model runtime, so this script does not call them observed wall-clock timings.
+"""
+
+import argparse
+import csv
+import json
+import statistics
+from pathlib import Path
+
+
+def summarize(rows: list[dict]) -> dict:
+    components = [json.loads(row["component_times"]) for row in rows]
+
+    def median_fraction(numerator: str, denominator: str) -> float | None:
+        values = [
+            item.get(numerator, 0) / item[denominator]
+            for item in components
+            if item.get(denominator, 0) > 0
+        ]
+        return statistics.median(values) if values else None
+
+    return {
+        "n_rows": len(rows),
+        "median_end_to_end_seconds": statistics.median(
+            item["end_to_end"] for item in components if "end_to_end" in item
+        ),
+        "median_tuning_fraction": median_fraction("tuning", "end_to_end"),
+        "median_execution_fraction": median_fraction("execution", "end_to_end"),
+        "median_profiling_of_tuning_fraction": median_fraction("profiling", "tuning"),
+        "scope": "shipped paper CSV; phase times may include simulated model runtime",
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, default=Path("artifacts/base01/merged"))
+    args = parser.parse_args()
+    for path in sorted(args.root.rglob("baselines.csv")):
+        with path.open(newline="") as stream:
+            rows = [
+                row
+                for row in csv.DictReader(stream)
+                if row["approach"] == "optim_global"
+            ]
+        if rows:
+            print(json.dumps({"benchmark": path.parent.parent.name, **summarize(rows)}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/research/ollama_llm_cache_probe.py b/research/ollama_llm_cache_probe.py
new file mode 100644
index 0000000..cf3d97f
--- /dev/null
+++ b/research/ollama_llm_cache_probe.py
@@ -0,0 +1,135 @@
+"""Exercise Stretto's reasoning-LLM cache against a local real model.
+
+This is a component probe, not an end-to-end Stretto query or KV-server
+benchmark. Requests are forced to the local Ollama OpenAI-compatible endpoint.
+"""
+
+import argparse
+import asyncio
+import csv
+import json
+import os
+import tempfile
+import time
+import urllib.request
+from pathlib import Path
+
+from reasondb.reasoning import llm
+from reasondb.utils.timing import SimulatedClock
+
+
+DATASETS = {
+    "reviews": ("reviews_10000.csv", "reviewtext"),
+    "emails": ("emails_with_cpt.csv", "text"),
+}
+LOCAL_ENDPOINT = "http://127.0.0.1:11434"
+
+
+class QuietLogger:
+    def debug(self, *_args):
+        pass
+
+
+class CountingModel(llm.OpenAILLM):
+    def __init__(self, model_id):
+        super().__init__(
+            model_id, llm.LLMCharacteristics(100, 100000, 32, 4096, 0, 0), True
+        )
+        self.remote_calls = 0
+
+    async def _invoke(self, prompt, stop=[]):
+        self.remote_calls += 1
+        return await super()._invoke(prompt, stop)
+
+
+def contexts(dataset: str, count: int) -> list[str]:
+    filename, column = DATASETS[dataset]
+    source = (
+        Path(__file__).parents[1] / "reasondb/evaluation/benchmarks/files" / filename
+    )
+    with source.open(newline="") as stream:
+        return [row[column][:500] for row in csv.DictReader(stream) if row[column]][
+            :count
+        ]
+
+
+async def probe(model_name: str, count: int) -> None:
+    original_cache_dir = llm.LLM_CACHE_DIR
+    with tempfile.TemporaryDirectory(prefix="stretto-local-llm-") as directory:
+        llm.LLM_CACHE_DIR = Path(directory)
+        model = CountingModel(model_name)
+        await model.prepare()
+        try:
+            for dataset in DATASETS:
+                prompts = [
+                    llm.Prompt(
+                        [
+                            llm.Message(
+                                f"Answer yes or no only: Does this text express a positive opinion?\n{text}",
+                                "user",
+                            )
+                        ]
+                    )
+                    for text in contexts(dataset, count)
+                ]
+                first, repeat = [], []
+                first_answers, repeat_answers = [], []
+                calls_before_first = model.remote_calls
+                for prompt in prompts:
+                    start = time.perf_counter()
+                    answer, _runtime, _cost = await model.invoke_with_runtime_and_cost(
+                        prompt, QuietLogger()
+                    )
+                    first.append(time.perf_counter() - start)
+                    first_answers.append(answer)
+                calls_after_first = model.remote_calls
+                simulated_before = SimulatedClock.now()
+                for prompt in prompts:
+                    start = time.perf_counter()
+                    answer, _runtime, _cost = await model.invoke_with_runtime_and_cost(
+                        prompt, QuietLogger()
+                    )
+                    repeat.append(time.perf_counter() - start)
+                    repeat_answers.append(answer)
+                print(
+                    json.dumps(
+                        {
+                            "dataset": dataset,
+                            "model": model_name,
+                            "unique_prompts": len(prompts),
+                            "new_remote_calls": calls_after_first - calls_before_first,
+                            "repeat_remote_calls": model.remote_calls
+                            - calls_after_first,
+                            "first_wall_seconds": first,
+                            "repeat_wall_seconds": repeat,
+                            "repeat_answers_equal": first_answers == repeat_answers,
+                            "simulated_clock_credit_on_repeat_seconds": SimulatedClock.now()
+                            - simulated_before,
+                            "scope": "Stretto reasoning-LLM component; not full query execution",
+                        }
+                    ),
+                    flush=True,
+                )
+        finally:
+            await model.close()
+            llm.LLM_CACHE_DIR = original_cache_dir
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", default="mistral:latest")
+    parser.add_argument("--items-per-dataset", type=int, default=2)
+    args = parser.parse_args()
+    if args.items_per_dataset < 1:
+        parser.error("--items-per-dataset must be positive")
+    with urllib.request.urlopen(f"{LOCAL_ENDPOINT}/v1/models", timeout=5) as response:
+        model_ids = {model["id"] for model in json.load(response)["data"]}
+    if args.model not in model_ids:
+        parser.error(f"{args.model!r} is not served by local Ollama")
+    os.environ["OPENAI_API_KEY"] = "ollama"
+    os.environ["OPENAI_BASE_URL"] = f"{LOCAL_ENDPOINT}/v1"
+    asyncio.run(probe(args.model, args.items_per_dataset))
+
+
+if __name__ == "__main__":
+    main()
