+"""Demonstrate the current replay key's mutable-image boundary without a model.
+
+This is a diagnostic, not proof that Stretto's static benchmark snapshots are
+incorrect. It asks what happens if the same path is reused for changed bytes.
+"""
+
+import json
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from reasondb.backends.simulate_store import SimulateStore
+
+
+def main() -> None:
+    with TemporaryDirectory() as directory:
+        path = Path(directory) / "image.bin"
+        path.write_bytes(b"original-image")
+        store = SimulateStore()
+        store.record_vision(
+            "model",
+            "what is shown?",
+            str(path),
+            "old-answer",
+            0.0,
+            0.1,
+            0.0,
+            None,
+            None,
+            True,
+        )
+        path.write_bytes(b"replacement-image")
+        response = store.lookup_vision("model", "what is shown?", str(path))
+        print(
+            json.dumps(
+                {
+                    "content_changed": True,
+                    "old_response_replayed": response[0] == "old-answer",
+                }
+            )
+        )
+
+
+if __name__ == "__main__":
+    main()
