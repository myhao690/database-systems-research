+    monkeypatch.setattr(embeddings, "EMBEDDING_CACHE_DIR", embedding_dir)
+    prompt = _prompt()
+    old_llm_hash = hashlib.sha256(
+        f"{prompt}-{prompt.temperature}-{prompt.seed}".encode()
+    ).hexdigest()
+    (llm_dir / old_llm_hash).write_text(
+        json.dumps(
+            {
+                "prompt": str(prompt),
+                "temperature": prompt.temperature,
+                "seed": prompt.seed,
+                "response": "stale",
+                "runtime": 1.0,
+                "cost": 0.0,
+            }
+        )
+    )
+    text = "example"
+    (embedding_dir / hashlib.sha256(text.encode()).hexdigest()).write_text(
+        json.dumps({"prompt": text, "response": [999]})
+    )
+    model = _LLM("model-a")
+    embedder = _Embedding("model-a", 3)
+
+    async def exercise():
+        await model.prepare()
+        assert (await model.invoke(prompt, _Logger())) == "model-a::1"
