+"""Trace audit must not mistake modelled phase time for observed wall time."""
+
+import json
+
+from reasondb.backends.simulate_store import SimulateStore
+from reasondb.evaluation.precompute import run_precompute
+from reasondb.monitor.collector import Collector
+from research.audit_precompute_trace import audit
+
+
+def test_audit_groups_interleaved_jobs_and_write_kinds(tmp_path):
+    trace = tmp_path / "events.jsonl"
+    events = [
+        {
+            "type": "query_end",
+            "data": {
+                "job_id": "a",
+                "role": "precompute",
+                "cached": False,
+                "component_times": {"end_to_end": 999},
+            },
+        },
+        {
+            "type": "query_end",
+            "data": {"job_id": "b", "role": "sweep", "cached": False},
+        },
+        {
+            "type": "precompute_save",
+            "data": {
+                "job_id": "a",
+                "kind": "delta",
+                "size_bytes": 100,
+                "seconds": 0.01,
+            },
+        },
+        {
+            "type": "query_end",
+            "data": {"job_id": "a", "role": "precompute", "cached": True},
+        },
+        {
+            "type": "precompute_save",
+            "data": {"job_id": "a", "kind": "full", "size_bytes": 200, "seconds": 0.02},
+        },
+        {
+            "type": "query_end",
+            "data": {"job_id": "b", "role": "precompute", "cached": False},
+        },
+        {
+            "type": "precompute_save",
+            "data": {"job_id": "b", "size_bytes": 50, "seconds": 0.03},
+        },
+    ]
+    trace.write_text("".join(json.dumps(event) + "\n" for event in events))
+    rows = audit(trace)
+    assert [row["job_id"] for row in rows] == ["a", "b"]
+    assert rows[0]["queries"] == 2
+    assert rows[0]["queries_with_new_records"] == 1
+    assert rows[0]["cached_queries"] == 1
+    assert rows[0]["written_bytes_by_kind"] == {"delta": 100, "full": 200}
+    assert rows[1]["queries"] == 1
+    assert rows[1]["written_bytes_by_kind"] == {"legacy_full": 50}
+    assert "observed_wall_seconds" not in rows[0]
+
+
+def test_audit_reads_real_precompute_telemetry(tmp_path):
+    class Query:
+        def __init__(self, name):
+            self.query = name
+
+    class Benchmark:
+        queries = [Query("new"), Query("repeat")]
+
+    class Executor:
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *_args):
+            return False
+
+        def precompute_query(self, query, _index):
+            if query.query == "new":
+                SimulateStore.get_precompute().record_text_qa(
+                    "model", "q", "ctx", "yes", 0.0, 0.1, 0.0, 0.0, True
+                )
+
+    trace = tmp_path / "events.jsonl"
+    collector = Collector(jsonl_path=trace).install()
+    try:
+        run_precompute(Benchmark(), Executor(), tmp_path / "recording.json")
+    finally:
+        collector.close()
+    [summary] = audit(trace)
+    assert summary["queries"] == 2
+    assert summary["queries_with_new_records"] == 1
+    assert summary["cached_queries"] == 1
+    assert summary["write_count_by_kind"] == {"delta": 1, "full": 1}
