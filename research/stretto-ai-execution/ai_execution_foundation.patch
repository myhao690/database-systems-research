diff --git a/research/bench_replay_store.py b/research/bench_replay_store.py
new file mode 100644
index 0000000..07da26f
--- /dev/null
+++ b/research/bench_replay_store.py
@@ -0,0 +1,135 @@
+"""Baseline checkpoint cost using Stretto's bundled real text columns.
+
+No model inference: this profiles SimulateStore recording/checkpointing only.
+Each synthetic query uses a different question over the same real contexts.
+"""
+
+import argparse
+import csv
+import json
+import resource
+import tempfile
+import time
+from pathlib import Path
+
+from reasondb.backends.simulate_store import SimulateStore
+
+
+DATASETS = {
+    "reviews": ("reviews_10000.csv", "reviewtext"),
+    "emails": ("emails_with_cpt.csv", "text"),
+}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--dataset", choices=DATASETS, required=True)
+    parser.add_argument("--queries", type=int, default=10)
+    parser.add_argument(
+        "--mode", choices=("full", "full_dirty", "incremental"), default="full"
+    )
+    parser.add_argument(
+        "--active-queries",
+        type=int,
+        help="Only this many queries add new records; the rest are no-ops",
+    )
+    args = parser.parse_args()
+    active_queries = (
+        args.queries if args.active_queries is None else args.active_queries
+    )
+    if not 0 <= active_queries <= args.queries:
+        parser.error("--active-queries must be between 0 and --queries")
+    filename, column = DATASETS[args.dataset]
+    source = (
+        Path(__file__).parents[1] / "reasondb/evaluation/benchmarks/files" / filename
+    )
+    with source.open(newline="") as stream:
+        contexts = [row[column] for row in csv.DictReader(stream) if row[column]]
+    store = SimulateStore()
+    with tempfile.TemporaryDirectory(prefix="stretto-replay-baseline-") as directory:
+        path = Path(directory) / "recording.json"
+        total_written = 0
+        total_save_time = 0.0
+        for query_id in range(args.queries):
+            question = f"What is the category? Variant {query_id}"
+            if query_id < active_queries:
+                for context in contexts:
+                    store.record_text_qa(
+                        model_id="offline-replay-probe",
+                        question=question,
+                        context=context,
+                        response="yes",
+                        log_odds=0.0,
+                        runtime=0.1,
+                        effective_compression_ratio=0.0,
+                        materialized_compression_ratio=0.0,
+                        vanilla=True,
+                    )
+            start = time.perf_counter()
+            if args.mode == "full" or (
+                args.mode == "full_dirty" and query_id < active_queries
+            ):
+                store.save(path)
+                size = path.stat().st_size
+            elif args.mode == "full_dirty":
+                size = 0
+            else:
+                checkpoint = store.checkpoint_delta(path)
+                size = checkpoint.stat().st_size if checkpoint is not None else 0
+            seconds = time.perf_counter() - start
+            total_written += size
+            total_save_time += seconds
+            print(
+                json.dumps(
+                    {
+                        "kind": "checkpoint",
+                        "dataset": args.dataset,
+                        "mode": args.mode,
+                        "query": query_id + 1,
+                        "entries": store.counts()["n_text_qa"],
+                        "seconds": seconds,
+                        "file_bytes": size,
+                    }
+                ),
+                flush=True,
+            )
+        finalize_seconds = 0.0
+        if args.mode == "incremental":
+            start = time.perf_counter()
+            store.finalize_checkpoints(path)
+            finalize_seconds = time.perf_counter() - start
+            total_written += path.stat().st_size
+        elif not path.exists():
+            store.save(path)
+            total_written += path.stat().st_size
+        start = time.perf_counter()
+        restored = SimulateStore.load(path)
+        load_seconds = time.perf_counter() - start
+        print(
+            json.dumps(
+                {
+                    "kind": "summary",
+                    "dataset": args.dataset,
+                    "mode": args.mode,
+                    "queries": args.queries,
+                    "active_queries": active_queries,
+                    "contexts_per_query": len(contexts),
+                    "entries": store.counts()["n_text_qa"],
+                    "restored_entries": restored.counts()["n_text_qa"],
+                    "total_save_seconds": total_save_time,
+                    "finalize_seconds": finalize_seconds,
+                    "load_seconds": load_seconds,
+                    "total_file_bytes_written": total_written,
+                    "final_file_bytes": path.stat().st_size,
+                    "write_amplification": total_written / path.stat().st_size,
+                    "peak_rss_bytes": resource.getrusage(
+                        resource.RUSAGE_SELF
+                    ).ru_maxrss,
+                }
+            ),
+            flush=True,
+        )
+
+
+if __name__ == "__main__":
+    main()
