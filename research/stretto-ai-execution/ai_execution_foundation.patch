+    monkeypatch.setattr(llm, "LLM_CACHE_DIR", tmp_path / "llm")
+    model = _LLM("model-a")
+    model.cache_enabled = False
+    prompt = _prompt(tmp_path / "missing-image.png")
+
+    async def exercise():
+        await model.prepare()
+        assert await model.invoke(prompt, _Logger()) == "model-a::1"
+
+    asyncio.run(exercise())
+
+
+def test_different_prompts_still_run_concurrently(tmp_path, monkeypatch):
+    monkeypatch.setattr(llm, "LLM_CACHE_DIR", tmp_path / "llm")
+
+    class SlowLLM(_LLM):
+        active = 0
+        max_active = 0
+
+        async def _invoke(self, prompt, stop=[]):
+            self.calls += 1
+            self.active += 1
+            self.max_active = max(self.max_active, self.active)
+            await asyncio.sleep(0.02)
+            self.active -= 1
+            return str(prompt), 0.02, 0.0
+
+    model = SlowLLM("model-a")
+
+    async def exercise():
+        await model.prepare()
+        await asyncio.gather(
+            *(
+                model.invoke(
+                    llm.Prompt([llm.Message(f"prompt-{i}", "user")]), _Logger()
+                )
+                for i in range(8)
+            )
+        )
+
+    asyncio.run(exercise())
+    assert model.calls == 8
+    assert model.max_active > 1
+
+
+def test_concurrent_identical_embeddings_invoke_model_once(tmp_path, monkeypatch):
+    monkeypatch.setattr(embeddings, "EMBEDDING_CACHE_DIR", tmp_path / "embeddings")
+
+    class SlowEmbedding(_Embedding):
+        async def _embed(self, text):
+            self.calls += 1
+            await asyncio.sleep(0.02)
+            return np.array([self.calls, len(text)])
+
+    model = SlowEmbedding("model-a", 7)
+
+    async def exercise():
+        return await asyncio.gather(
+            *(model.embed("example", _Logger()) for _ in range(20))
+        )
+
+    for result in asyncio.run(exercise()):
+        np.testing.assert_array_equal(result, [1, 7])
+    assert model.calls == 1
+
+
+def test_atomic_replacement_preserves_cache_file_permissions(tmp_path, monkeypatch):
+    monkeypatch.setattr(llm, "LLM_CACHE_DIR", tmp_path / "llm")
+    model = _LLM("model-a")
+    prompt = _prompt()
+    reference = tmp_path / "reference"
+    reference.write_text("baseline")
+    model.cache(prompt, "first", 0.1, 0.0)
+    path = llm.LLM_CACHE_DIR / model._cache_key(prompt, [])
+    assert stat.S_IMODE(path.stat().st_mode) == stat.S_IMODE(reference.stat().st_mode)
+
+    path.chmod(0o640)
+    model.cache(prompt, "second", 0.1, 0.0)
+    assert stat.S_IMODE(path.stat().st_mode) == 0o640
+
+
+def test_embedding_cache_uses_actual_truncated_request(tmp_path, monkeypatch):
+    monkeypatch.setattr(embeddings, "EMBEDDING_CACHE_DIR", tmp_path / "embeddings")
+
+    class TruncatingEmbedding(_Embedding):
+        def _effective_input(self, text):
+            return text[: self.characteristics.in_len]
+
+    model = TruncatingEmbedding("model-a", 3)
+
+    async def exercise():
+        np.testing.assert_array_equal(await model.embed("abcX", _Logger()), [1, 3])
+        np.testing.assert_array_equal(await model.embed("abcY", _Logger()), [1, 3])
+
+    asyncio.run(exercise())
+    assert model.calls == 1
+
+
+def test_corrupt_embedding_entry_warns_before_recomputation(tmp_path, monkeypatch):
+    monkeypatch.setattr(embeddings, "EMBEDDING_CACHE_DIR", tmp_path / "embeddings")
+    model = _Embedding("model-a", 3)
+    text = "abc"
+
+    async def exercise():
+        await model.embed(text, _Logger())
+        (embeddings.EMBEDDING_CACHE_DIR / model._cache_key(text)).write_text("{")
+        with pytest.warns(RuntimeWarning, match="Corrupt embedding cache entry"):
+            await model.embed(text, _Logger())
+
+    asyncio.run(exercise())
+    assert model.calls == 2
