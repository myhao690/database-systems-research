+def test_frozen_prompt_sends_original_image_after_path_changes(tmp_path):
+    image = tmp_path / "image.png"
+    Image.new("RGB", (2, 2), "red").save(image)
+    frozen = _prompt(image).snapshot()
+    original_hash = frozen.sha256()
+    Image.new("RGB", (2, 2), "green").save(image)
