@@ -0,0 +1,56 @@
+"""Show the current query-level durability boundary without model inference."""
+
+import json
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+from reasondb.backends.simulate_store import SimulateStore
+from reasondb.evaluation.precompute import run_precompute
+
+
+class Query:
+    query = "one-long-query"
+
+
+class Benchmark:
+    queries = [Query()]
+
+
+class FailingExecutor:
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_args):
+        return False
+
+    def precompute_query(self, _query, _index):
+        store = SimulateStore.get_precompute()
+        for item in ("first", "second"):
+            store.record_text_qa(
+                "model", "question", item, "yes", 0.0, 1.0, 0.0, 0.0, True
+            )
+        raise RuntimeError("interrupted before query checkpoint")
+
+
+def main() -> None:
+    with TemporaryDirectory() as directory:
+        path = Path(directory) / "recording.json"
+        try:
+            run_precompute(Benchmark(), FailingExecutor(), path)
+        except RuntimeError as error:
+            if str(error) != "interrupted before query checkpoint":
+                raise
+        restored = SimulateStore.load_incremental(path)
+        print(
+            json.dumps(
+                {
+                    "answers_recorded_before_failure": 2,
+                    "answers_available_after_restart": restored.counts()["n_text_qa"],
+                    "durability_boundary": "completed query, not individual model call",
+                }
+            )
+        )
+
+
+if __name__ == "__main__":
+    main()
