index 0000000..6dc361e
--- /dev/null
+++ b/research/audit_precompute_trace.py
@@ -0,0 +1,77 @@
+"""Summarize real monitor JSONL before choosing a persistence mechanism.
+
+Only reports observed event counts and write telemetry. Event timestamps use
+``time.time`` and simulated phase durations may include credited model runtime,
+so neither is treated here as an independently measured query wall time.
+"""
+
+import argparse
+import json
+from collections import defaultdict
+from pathlib import Path
+
+
+def audit(path: Path) -> list[dict]:
+    jobs = defaultdict(
+        lambda: {
+            "queries": 0,
+            "queries_with_new_records": 0,
+            "cached_queries": 0,
+            "write_count_by_kind": defaultdict(int),
+            "written_bytes_by_kind": defaultdict(int),
+            "save_seconds_by_kind": defaultdict(float),
+        }
+    )
+    with path.open() as stream:
+        for line_number, line in enumerate(stream, 1):
+            if not line.strip():
+                continue
+            try:
+                event = json.loads(line)
+            except json.JSONDecodeError as exc:
+                raise ValueError(f"{path}:{line_number}: invalid JSON") from exc
+            kind = event.get("type")
+            data = event.get("data") or {}
+            if kind not in ("query_end", "precompute_save"):
+                continue
+            if kind == "query_end" and data.get("role") != "precompute":
+                continue
+            job = str(data.get("job_id") or "local")
+            result = jobs[job]
+            if kind == "query_end":
+                result["queries"] += 1
+                if data.get("cached"):
+                    result["cached_queries"] += 1
+                else:
+                    result["queries_with_new_records"] += 1
+            else:
+                write_kind = str(data.get("kind") or "legacy_full")
+                result["write_count_by_kind"][write_kind] += 1
+                result["written_bytes_by_kind"][write_kind] += int(
+                    data.get("size_bytes") or 0
+                )
+                result["save_seconds_by_kind"][write_kind] += float(
+                    data.get("seconds") or 0
+                )
+    return [
+        {
+            "job_id": job,
+            **{
+                k: dict(v) if isinstance(v, defaultdict) else v
+                for k, v in value.items()
+            },
+        }
+        for job, value in sorted(jobs.items())
+    ]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("trace", type=Path, help="Stretto monitor JSONL sidecar")
+    args = parser.parse_args()
+    for result in audit(args.trace):
+        print(json.dumps(result, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
