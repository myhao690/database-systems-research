+def test_embedding_cache_separates_model_and_input_limit(tmp_path, monkeypatch):
+    monkeypatch.setattr(embeddings, "EMBEDDING_CACHE_DIR", tmp_path / "embeddings")
+    first = _Embedding("model-a", 3)
+    second = _Embedding("model-b", 3)
+    longer_input = _Embedding("model-a", 7)
+
+    async def exercise():
+        assert first.calls == 0
+        np.testing.assert_array_equal(await first.embed("abcdefg", _Logger()), [1, 3])
+        np.testing.assert_array_equal(await first.embed("abcdefg", _Logger()), [1, 3])
+        np.testing.assert_array_equal(await second.embed("abcdefg", _Logger()), [1, 3])
+        np.testing.assert_array_equal(
+            await longer_input.embed("abcdefg", _Logger()), [1, 7]
+        )
+
+    asyncio.run(exercise())
+    assert (first.calls, second.calls, longer_input.calls) == (1, 1, 1)
