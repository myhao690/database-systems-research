+"""Regression tests for the identity of cached AI operator results."""
+
+import asyncio
+import base64
+import hashlib
+import io
+import json
+import stat
+
+import numpy as np
+import pytest
+from PIL import Image
+
+from reasondb.reasoning import embeddings, llm
+
+
+class _Logger:
+    def debug(self, *_args):
+        pass
+
+
+class _LLM(llm.LargeLanguageModel):
+    def __init__(self, model_id):
+        super().__init__(
+            model_id,
+            llm.LLMCharacteristics(1, 1, 1, 1, 0, 0),
+            cache_enabled=True,
+        )
+        self.calls = 0
+
+    async def _invoke(self, prompt, stop=[]):
+        self.calls += 1
+        return f"{self.model_id}:{','.join(stop)}:{self.calls}", 0.1, 0.0
+
+
+class _Embedding(embeddings.TextEmbeddingModel):
+    def __init__(self, model_id, in_len):
+        super().__init__(
+            model_id, embeddings.EmbeddingCharacteristics(1, 1, 1, in_len, 0)
+        )
+        self.calls = 0
+
+    async def _embed(self, text):
+        self.calls += 1
+        return np.array(
+            [float(self.calls), float(len(text[: self.characteristics.in_len]))]
+        )
+
+
+def _prompt(image=None):
+    return llm.Prompt([llm.Message("classify this", "user", image=image)])
+
+
+def test_llm_cache_separates_model_and_stop(tmp_path, monkeypatch):
+    monkeypatch.setattr(llm, "LLM_CACHE_DIR", tmp_path / "llm")
+    first, second = _LLM("model-a"), _LLM("model-b")
+
+    async def exercise():
+        await first.prepare()
+        await second.prepare()
+        prompt = _prompt()
+        assert (await first.invoke(prompt, _Logger())) == "model-a::1"
+        assert (await first.invoke(prompt, _Logger())) == "model-a::1"
+        assert (await second.invoke(prompt, _Logger())) == "model-b::1"
+        assert (await first.invoke(prompt, _Logger(), stop=["END"])) == "model-a:END:2"
+
+    asyncio.run(exercise())
+    assert (first.calls, second.calls) == (2, 1)
+
+
+def test_llm_cache_detects_changed_image_bytes(tmp_path, monkeypatch):
+    monkeypatch.setattr(llm, "LLM_CACHE_DIR", tmp_path / "llm")
+    image = tmp_path / "image.png"
+    image.write_bytes(b"old image")
+    model = _LLM("model-a")
+
+    async def exercise():
+        await model.prepare()
+        assert (await model.invoke(_prompt(image), _Logger())) == "model-a::1"
+        image.write_bytes(b"new image")
+        assert (await model.invoke(_prompt(image), _Logger())) == "model-a::2"
+
+    asyncio.run(exercise())
+    assert model.calls == 2
+
