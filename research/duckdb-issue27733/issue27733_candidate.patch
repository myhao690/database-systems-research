 namespace duckdb {
 
+TEST_CASE("Tuple data merges adjacent variable-size chunk parts and retains one spare", "[tuple_data_allocation]") {
+	DuckDB db(nullptr);
+	Connection con(db);
+	auto &buffer_manager = BufferManager::GetBufferManager(*con.context);
+	auto layout = make_shared_ptr<TupleDataLayout>();
+	layout->Initialize({LogicalType::VARCHAR}, TupleDataValidityType::CAN_HAVE_NULL_VALUES);
+	auto arena = make_shared_ptr<ArenaAllocator>(buffer_manager.GetBufferAllocator());
+	auto allocator = make_shared_ptr<TupleDataAllocator>(buffer_manager, layout, MemoryTag::HASH_TABLE, arena);
+	TupleDataSegment segment(allocator);
+	TupleDataChunk chunk(*arena->Make<mutex>());
+	const auto heap_ptr = arena->Allocate(128);
+
+	auto first = arena->MakeUnsafePtr<TupleDataChunkPart>(chunk.lock.get());
+	first->row_block_index = 0;
+	first->row_block_offset = 0;
+	first->heap_block_index = 0;
+	first->heap_block_offset = 100;
+	first->total_heap_size = 50;
+	first->base_heap_ptr = heap_ptr;
+	first->count = 1;
+	chunk.AddPart(segment, std::move(first));
+
+	auto second = arena->MakeUnsafePtr<TupleDataChunkPart>(chunk.lock.get());
+	second->row_block_index = 0;
+	second->row_block_offset = NumericCast<uint32_t>(layout->GetRowWidth());
+	second->heap_block_index = 0;
+	second->heap_block_offset = 150;
+	second->total_heap_size = 30;
+	second->base_heap_ptr = heap_ptr;
+	second->count = 1;
+	auto *second_ptr = second.get();
+	chunk.AddPart(segment, std::move(second));
+
+	chunk.MergeLastChunkPart(segment);
+	REQUIRE(chunk.part_ids.Size() == 1);
+	REQUIRE(chunk.count == 2);
+	REQUIRE(segment.chunk_parts.size() == 1);
+	REQUIRE(segment.chunk_parts[0]->count == 2);
+	REQUIRE(segment.chunk_parts[0]->total_heap_size == 80);
+	REQUIRE(segment.spare_chunk_part.get() == second_ptr);
+
+	auto nonadjacent = std::move(segment.spare_chunk_part);
+	nonadjacent->row_block_offset = NumericCast<uint32_t>(2 * layout->GetRowWidth());
+	nonadjacent->heap_block_offset = 181;
+	nonadjacent->total_heap_size = 10;
+	nonadjacent->count = 1;
+	chunk.AddPart(segment, std::move(nonadjacent));
+	chunk.MergeLastChunkPart(segment);
+	REQUIRE(chunk.part_ids.Size() == 2);
+	REQUIRE(segment.chunk_parts.size() == 2);
+	REQUIRE(!segment.spare_chunk_part);
+}
+
+TEST_CASE("Tuple data reuses merged variable-size metadata across appends", "[tuple_data_allocation]") {
+	DuckDB db(nullptr);
+	Connection con(db);
+	auto &buffer_manager = BufferManager::GetBufferManager(*con.context);
+	vector<LogicalType> types {LogicalType::VARCHAR};
+	auto layout = make_shared_ptr<TupleDataLayout>();
+	layout->Initialize(types, TupleDataValidityType::CAN_HAVE_NULL_VALUES);
+	auto arena = make_shared_ptr<ArenaAllocator>(buffer_manager.GetBufferAllocator());
+	TupleDataCollection collection(buffer_manager, layout, MemoryTag::HASH_TABLE, arena);
+	TupleDataAppendState append_state;
+	collection.InitializeAppend(append_state);
+	DataChunk chunk;
+	chunk.Initialize(Allocator::DefaultAllocator(), types);
+	for (idx_t i = 0; i < 8192; i++) {
+		chunk.Reset();
+		auto writer = FlatVector::Writer<string_t>(chunk.data[0], 1);
+		writer.WriteValue(string_t("abcdefghijklmnopqrst"));
+		collection.Append(append_state, chunk);
+	}
+	collection.FinalizePinState(append_state.pin_state);
+	REQUIRE(collection.Count() == 8192);
+	REQUIRE(arena->AllocationSize() < 128 * 1024);
+}
