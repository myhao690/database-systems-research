+bool IsFSST12Expression(const OperatorToken token) {
+	switch (token) {
+	case OperatorToken::EXP_FSST12_DICT_STR_U32:
+	case OperatorToken::EXP_FSST12_DICT_STR_U16:
+	case OperatorToken::EXP_FSST12_DICT_STR_U08:
+	case OperatorToken::EXP_FSST12_DICT_STR_FFOR_SLPATCH_U32:
+	case OperatorToken::EXP_FSST12_DICT_STR_FFOR_SLPATCH_U16:
+	case OperatorToken::EXP_FSST12_DICT_STR_FFOR_U08:
+	case OperatorToken::EXP_FSST12_DICT_STR_FFOR_SLPATCH_U08:
+	case OperatorToken::EXP_FSST12_DELTA:
+	case OperatorToken::EXP_FSST12_DELTA_SLPATCH:
+		return true;
+	default:
+		return false;
+	}
+}
+
+bool SkipFSST12ForShortStringSample(const rowgroup_pt& rowgroup,
+                                    const ColumnDescriptorT& column_descriptor,
+                                    const RowgroupDescriptorT& footer,
+                                    const Connection& fls) {
+	// Preserve explicit candidate and sampling choices; keep feature work bounded.
+	if (fls.is_forced_schema_pool() || fls.is_forced_schema() ||
+	    fls.get_sample_size() != CFG::SAMPLER::SAMPLE_SIZE || footer.m_n_vec == 0) {
+		return false;
+	}
+	const auto* column = std::get_if<up<FLSStrColumn>>(&rowgroup[column_descriptor.idx]);
+	if (!column || !*column) {
+		return false;
+	}
+
+	auto sample_size = fls.get_sample_size();
+	if (sample_size == 0 || sample_size > footer.m_n_vec) {
+		sample_size = footer.m_n_vec;
+	}
+	const n_t* vec_idxs;
+	vector<n_t> dyn_layout;
+	if (footer.m_n_vec == 64) {
+		vec_idxs = sampling_layout_64.data();
+	} else if (footer.m_n_vec == 32) {
+		vec_idxs = sampling_layout_32.data();
+	} else if (footer.m_n_vec == 2) {
+		vec_idxs = sampling_layout_2.data();
+	} else if (footer.m_n_vec == 1) {
+		vec_idxs = sampling_layout_1.data();
+	} else {
+		dyn_layout = sampling_layout_dynamic(footer.m_n_vec);
+		vec_idxs = dyn_layout.data();
+	}
+
+	uint64_t length_sum = 0;
+	uint64_t count = 0;
+	for (n_t vec = 0; vec < sample_size; ++vec) {
+		const size_t begin = static_cast<size_t>(vec_idxs[vec]) * CFG::VEC_SZ;
+		const size_t end = std::min<size_t>(begin + CFG::VEC_SZ, (*column)->length_arr.size());
+		for (size_t row = begin; row < end; ++row) {
+			const auto length = (*column)->length_arr[row];
+			if (length != 0) {
+				length_sum += length;
+				++count;
+			}
+		}
+	}
+	// This is a conservative candidate-filtering heuristic, not a size bound.
+	constexpr uint64_t min_avg_length = 16;
+	return count != 0 && length_sum < min_avg_length * count;
+}
