+++ b/test/src/unit_tests/wizard_sample_gate_test.cpp
@@ -0,0 +1,90 @@
+#include "fastlanes.hpp"
+#include "fls/reader/table_reader.hpp"
+#include "fls/table/table.hpp"
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <gtest/gtest.h>
+#include <random>
+#include <string>
+#include <system_error>
+
+namespace fastlanes { namespace {
+
+struct TempTable {
+	std::filesystem::path root;
+	std::filesystem::path input;
+
+	TempTable() {
+		root =
+		    std::filesystem::temp_directory_path() /
+		    ("fls_wizard_sample_gate_" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()) +
+			 "_" + std::to_string(std::random_device {}()));
+		input = root / "input";
+		std::filesystem::create_directories(input);
+	}
+
+	~TempTable() {
+		std::error_code ignored;
+		std::filesystem::remove_all(root, ignored);
+	}
+
+	void Write(bool two_columns) const {
+		std::ofstream schema(input / "schema.json");
+		schema << "{\"table\":\"sample_gate_test\",\"columns\":[{\"name\":\"s\",\"type\":\"VARCHAR\"}";
+		if (two_columns) {
+			schema << ",{\"name\":\"n\",\"type\":\"BIGINT\"}";
+		}
+		schema << "]}";
+		schema.close();
+
+		std::ofstream csv(input / "data.csv");
+		const char*   nullable_values[] = {"x", "NULL", "", "short", "ordinary title here"};
+		const char*   plain_values[]    = {"a", "b", "c"};
+		for (int i = 0; i < 1024; ++i) {
+			csv << (two_columns ? nullable_values[i % 5] : plain_values[i % 3]);
+			if (two_columns) {
+				csv << '|' << i;
+			}
+			csv << '\n';
+		}
+	}
+
+	void CheckRoundTrip(Connection& writer, const std::string& name) const {
+		const auto out = root / name / "data.fls";
+		std::filesystem::create_directories(out.parent_path());
+		writer.read_csv(input).to_fls(out);
+		Connection reader_connection;
+		auto       reader  = reader_connection.read_fls(out);
+		auto       decoded = reader->materialize();
+		const auto equal   = writer.get_table() == *decoded;
+		EXPECT_TRUE(equal.is_equal) << equal.description;
+	}
+};
+
+TEST(WizardSampleGate, ShortStringsNullsAndEmptyStringsRoundTrip) {
+	TempTable data;
+	data.Write(true);
+	Connection writer;
+	data.CheckRoundTrip(writer, "default");
+}
+
+TEST(WizardSampleGate, ExplicitFSST12OnlyPoolIsNotPruned) {
+	TempTable data;
+	data.Write(false);
+	Connection writer;
+	writer.force_schema_pool({OperatorToken::EXP_FSST12_DELTA});
+	data.CheckRoundTrip(writer, "forced");
+}
+
+TEST(WizardSampleGate, NonDefaultSampleSizesRemainValid) {
+	TempTable data;
+	data.Write(false);
+	for (const n_t sample_size : {1UL, 3UL}) {
+		Connection writer;
+		writer.set_sample_size(sample_size);
+		data.CheckRoundTrip(writer, "sample_" + std::to_string(sample_size));
+	}
+}
+
+}} // namespace fastlanes
