@@ -0,0 +1,29 @@
+#include "fls_tester.hpp"
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <string>
+
+namespace fastlanes {
+
+TEST_F(FastLanesReaderTester, SLPATCH_HIGH_CARDINALITY_AND_NULLS) {
+	const auto dir = std::filesystem::temp_directory_path() / ("fls_slpatch_" + std::to_string(getpid()));
+	std::filesystem::create_directories(dir);
+	{
+		std::ofstream schema(dir / "schema.json");
+		schema << R"({"table":"slpatch","columns":[{"name":"value","type":"BIGINT","nullability":"NULL","index":0}]})";
+		std::ofstream csv(dir / "slpatch.csv");
+		for (int64_t i = 0; i < 2048; ++i) {
+			if (i % 17 == 0) {
+				csv << "null\n";
+			} else {
+				csv << (i < 1024 ? i * 1000003 : i % 7) << '\n';
+			}
+		}
+	}
+
+	TestCorrectness(dir.string(), {OperatorToken::EXP_FFOR_SLPATCH_I64});
+	std::filesystem::remove_all(dir);
+}
+
+} // namespace fastlanes
