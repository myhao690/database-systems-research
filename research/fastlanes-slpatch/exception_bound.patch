+template <typename T>
+Option<T> find_best_slpatch_option(AnalyzeHistogram<T>& histogram) {
+	Option<T>   best {64, 0, 0};
+	const auto& reps = histogram.rep_vec;
+	if (reps.empty()) {
+		return best;
+	}
+
+	const auto n_option = static_cast<vec_idx_t>(reps.size());
+	vec_idx_t  excluded_left {0};
+	// Only intervals with fewer than LOCAL_EXC_LIMIT_C exceptions can win.
+	// Visit those intervals in the original (i, j) order to preserve tie-breaking.
+	for (vec_idx_t i {0}; i < n_option && excluded_left < LOCAL_EXC_LIMIT_C; ++i) {
+		vec_idx_t j = n_option - 1;
+		vec_idx_t excluded_right {0};
+		while (j > i && static_cast<n_t>(excluded_left) + excluded_right + reps[j] < LOCAL_EXC_LIMIT_C) {
+			excluded_right += reps[j];
+			--j;
+		}
+
+		vec_idx_t n_non_exceptions = CFG::VEC_SZ - excluded_left - excluded_right;
+		for (; j < n_option; ++j) {
+			auto next = find_best_option<T>(histogram, i, j, n_non_exceptions);
+			if (next.size() < best.size() && next.n_exceptions < LOCAL_EXC_LIMIT_C) {
+				best = next;
+			}
+			if (j + 1 < n_option) {
+				n_non_exceptions += reps[j + 1];
+			}
+		}
+		excluded_left += reps[i];
+	}
+	return best;
+}
